# Browser-exposed Vite configuration (set in Vercel for Preview and Production)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_LINE_LIFF_ID=
VITE_AUTH_ENDPOINT=/api/auth
VITE_BOOTSTRAP_ENDPOINT=/api/bootstrap

# Server-only secret. Never use a VITE_ prefix and never commit the value.
FIREBASE_SERVICE_ACCOUNT=

# Optional server-only override. If omitted, the API derives the channel ID
# from the prefix of VITE_LINE_LIFF_ID (for example: 1234567890-abcdefgh).
LINE_CHANNEL_ID=
